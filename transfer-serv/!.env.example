# Copy to .env. Keep the real .env private.
APP_ORIGIN=http://127.0.0.1:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Local HTTP only. Use 1 with public HTTPS.
COOKIE_SECURE=0
DATA_ROOT=./var
# Choose an unused private subnet if this conflicts with another network.
DOCKER_SUBNET=172.30.0.0/24
MAX_STORAGE_BYTES=100000000000
MIN_FREE_DISK_BYTES=5000000000
MAX_STORED_TRANSFERS=10000
MAX_ACTIVE_BYTES_PER_CLIENT=10000000000
MAX_DAILY_BYTES_PER_CLIENT=20000000000
MAX_DAILY_TRANSFERS_PER_CLIENT=100
