{
  "name": "transfer-serv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p frontend/tsconfig.json && tsc -p gateway/tsconfig.json && node scripts/clone-bootstrap.mjs",
    "check": "tsc -p frontend/tsconfig.json --noEmit && tsc -p gateway/tsconfig.json --noEmit",
    "dev:web": "node scripts/dev-web.mjs"
  },
  "dependencies": {
    "bootstrap": "5.3.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
